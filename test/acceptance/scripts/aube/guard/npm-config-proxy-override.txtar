# guarantee: npm config proxy settings in the environment cannot route aube
# around PMG. aube reads npm_config_https_proxy and npm_config_noproxy before
# HTTPS_PROXY and NO_PROXY. The script points them at a closed port and at the
# registry host. PMG overrides both, so the malicious package is still blocked.
# --allow-low-downloads skips aube's own low-download refusal, as in
# aube/guard/malware-block.

env HOME=$WORK/home
env AUBE_UPDATE_NOTIFIER=false
mkdir $WORK/home
env npm_config_https_proxy=http://127.0.0.1:1
env npm_config_noproxy=registry.npmjs.org

! exec pmg aube add --allow-low-downloads safedep-test-pkg@0.1.3
stdout 'Malicious package blocked'
! exists node_modules/safedep-test-pkg

-- package.json --
{
  "name": "acceptance-aube",
  "version": "1.0.0",
  "private": true
}
