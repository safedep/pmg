# guarantee: npm config proxy settings in the environment cannot route npm
# around PMG. npm reads npm_config_https_proxy and npm_config_noproxy before
# HTTPS_PROXY and NO_PROXY. The script points them at a closed port and at the
# registry host. PMG overrides both, so the malicious package is still blocked.
# (feature id derives from the path: npm/guard/npm-config-proxy-override)

env HOME=$WORK/home
mkdir $WORK/home
env npm_config_https_proxy=http://127.0.0.1:1
env npm_config_noproxy=registry.npmjs.org

exec pmg npm init -y
! exec pmg npm --no-cache --prefer-online install safedep-test-pkg@0.1.3
stdout 'Malicious package blocked'
! exists node_modules/safedep-test-pkg
