# guarantee: when PMG cannot reach the malware analysis service, it still
# installs the package, and the report names the package as allowed without
# analysis. HTTPS_PROXY names a closed port, so the analysis client fails to
# connect. NO_PROXY sends the registry traffic of PMG direct, and PMG gives
# npm its own proxy variables, so the install itself works.

env HOME=$WORK/home
mkdir $WORK/home
env HTTPS_PROXY=http://127.0.0.1:1
env NO_PROXY=registry.npmjs.org

exec pmg npm init -y
exec pmg npm --no-cache --prefer-online install lodash@4.17.21
stdout 'Malware analysis failed. PMG allowed these packages without analysis'
stdout 'pkg:npm/lodash@4.17.21'
exists node_modules/lodash
