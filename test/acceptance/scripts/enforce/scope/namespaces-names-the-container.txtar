# guarantee: under namespaces mode redirect, the stop report names the
# container behind a redirected connection by its name and image, not by its
# address.

[!enforce] skip 'enforcement needs root, kernel BTF and cgroup v2'
[!docker] skip 'docker not available'

env HOME=$WORK/home
mkdir $WORK/home

exec pmg setup cert install --system
exec pmg proxy start --daemon --enforce --enforce-namespaces redirect --profile $WORK/deny.yml --network-mode audit --state $ENFORCE_STATE
exec sh -c 'pmg proxy env --state "$ENFORCE_STATE" | grep PMG_CA_BUNDLE= | cut -d= -f2 > bundle.path'
exec sh -c 'test -s bundle.path'

# Audit lets the connection through, so the curl exit status says nothing
# about the policy. The report does.
exec sh -c 'docker run --rm --name pmg-label-probe -v "$(cat bundle.path)":/pmg-ca.pem:ro -e CURL_CA_BUNDLE=/pmg-ca.pem curlimages/curl:8.11.1 -sS -o /dev/null https://pastebin.com/ || true'

exec sh -c 'pmg proxy stop --state "$ENFORCE_STATE" 2>&1'
stdout 'would deny +pastebin\.com:443 +rule pastebin\.com:443 +container pmg-label-probe \(curlimages/curl:8\.11\.1\)'
! stdout 'rule pastebin\.com:443 +172\.'

-- deny.yml --
name: deny-pastebin
description: Denies pastebin.com, so the stop report names the client
package_managers: [npm, pip]
network:
  deny_outbound:
    - pastebin.com:443
