# guarantee: enforcement does not touch a process in another network
# namespace. A container keeps its own network and reaches the registry with
# the real certificate. Redirecting it to 127.0.0.1 would hit the container's
# own loopback and break it.

[!enforce] skip 'enforcement needs root, kernel BTF and cgroup v2'
[!docker] skip 'docker not available'

env HOME=$WORK/home
mkdir $WORK/home

exec pmg setup cert install --system
exec pmg proxy start --daemon --enforce --state $ENFORCE_STATE

exec docker run --rm curlimages/curl:8.11.1 -sS -o /dev/null -w '%{http_code}' https://registry.npmjs.org/
stdout '^200$'
