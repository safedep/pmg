# guarantee: on GitHub Actions the runner's binaries are not exempt. A daemon
# started below a process named Runner.Worker, with GITHUB_ACTIONS set,
# exempts no executable. A program copied next to Runner.Worker is routed.

[!enforce] skip 'enforcement needs root, kernel BTF and cgroup v2'
[!exec:curl] skip 'curl not installed'

env HOME=$WORK/home
mkdir $WORK/home $WORK/runner
exec sh -c 'cp "$(command -v sh)" "$WORK/runner/Runner.Worker"'
exec sh -c 'cp "$(command -v curl)" "$WORK/runner/Runner.Copy"'

exec pmg setup cert install --system
env GITHUB_ACTIONS=true
exec $WORK/runner/Runner.Worker -c 'pmg proxy start --daemon --enforce --state "$ENFORCE_STATE"'

exec pmg proxy status --state $ENFORCE_STATE
stdout 'Kernel enforcement: active'
! stdout 'exempt executable'

exec $WORK/runner/Runner.Copy -sSv -o /dev/null https://registry.npmjs.org/
stderr 'issuer:.*SafeDep PMG Proxy CA'
