# guarantee: `pmg sandbox violations list --json` output pipes into
# `pmg sandbox explain -`. The list holds summaries, not full records, so
# explain resolves the newest entry through its cache path and explains it.

[!exec:sh] skip
[bubblewrap] skip 'Bubblewrap does not support network_via_proxy_only, which the exec profile sets'

env HOME=$WORK/home
mkdir $WORK/home
env PMG_CACHE_DIR=$WORK/cache
cd $WORK/proj

# A denied read records a violation in the cache. The error text and the
# primary violation differ per driver, so assert only the non-zero exit.
! exec pmg sandbox exec -- cat .env

# explain resolves the newest entry and renders it. The header is stable
# across drivers. The secret content never appears.
exec sh -c 'pmg sandbox violations list --json | pmg sandbox explain -'
stdout 'Reason:'
! stdout value-must-never-be-read

-- proj/.env --
API_KEY=value-must-never-be-read
