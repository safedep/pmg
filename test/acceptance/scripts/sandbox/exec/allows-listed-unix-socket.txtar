# guarantee: a profile with network.allow_unix_connect opens the listed unix
# socket under `pmg sandbox exec` and keeps every other unix socket closed.
# A run cannot replace a name on the way to the socket. An entry stays
# closed when a write rule of the profile, of a built-in profile or of a
# built-in preset covers a name on its route, because a run under that
# profile could replace the name. Bubblewrap cannot check a socket path, so
# it refuses the profile. The Landlock driver refuses the list below
# Landlock ABI 9, unless the profile sets
# network.allow_unix_connect_without_kernel_check.

[!exec:python3] skip

env HOME=$WORK/home
mkdir $WORK/home/sock
env PMG_CACHE_DIR=$WORK/cache

# No built-in profile can write $HOME/sock. Built-in profiles can write the
# project and the temporary directories.
cd $WORK/home/sock
exec python3 $WORK/sock.py listen &listener&
exec python3 $WORK/sock.py wait
cd $WORK/proj
exec python3 $WORK/sock.py listen &projlistener&
exec python3 $WORK/sock.py wait

[bubblewrap] ! exec pmg sandbox exec --sandbox-profile $WORK/bwrap.yml -- python3 $WORK/sock.py $WORK/home/sock/host.sock
[bubblewrap] stderr 'network.allow_unix_connect is not supported'

# Linux below Landlock ABI 9: the Landlock driver refuses the list.
[linux] [!bubblewrap] [!landlock-unix-connect] ! exec pmg sandbox exec --sandbox-profile $WORK/allow.yml -- python3 $WORK/sock.py $WORK/home/sock/host.sock
[linux] [!bubblewrap] [!landlock-unix-connect] stderr 'needs Landlock ABI 9'
[linux] [!bubblewrap] [!landlock-unix-connect] ! stdout .

# Linux: $WORK is below /tmp, which built-in profiles can write. A run under
# one of them could replace host.sock and choose the socket of the next run,
# so the entry stays closed, also for a profile that cannot write there.
[linux] [!bubblewrap] ! exec pmg sandbox exec --sandbox-profile $WORK/sup.yml -- python3 $WORK/sock.py $WORK/home/sock/host.sock
[linux] [!bubblewrap] stderr 'leaves .*/home/sock/host.sock closed, because the write rule .* of profile '
[linux] [!bubblewrap] ! stderr 'needs Landlock ABI 9'
[linux] [!bubblewrap] stdout '^DENIED socket EACCES$'

# macOS: Seatbelt checks each connect and each write in the kernel.
[darwin] exec pmg sandbox exec --sandbox-profile $WORK/allow.yml -- python3 $WORK/sock.py $WORK/home/sock/host.sock
[darwin] stdout '^OK host$'

[darwin] ! exec pmg sandbox exec --sandbox-profile $WORK/allow.yml -- python3 $WORK/sock.py $WORK/home/sock/other.sock
[darwin] stdout '^DENIED connect E(ACCES|PERM)$'

# A run could replace a socket in the project, so the entry stays closed.
[darwin] ! exec pmg sandbox exec --sandbox-profile $WORK/cwd.yml -- python3 $WORK/sock.py $WORK/proj/host.sock
[darwin] stderr 'leaves .*/proj/host.sock closed, because the write rule .* of this profile'
[darwin] stdout '^DENIED connect E(ACCES|PERM)$'

# A run cannot replace the listed socket, so it cannot choose the socket
# that the next run reaches.
[darwin] ! exec pmg sandbox exec --sandbox-profile $WORK/allow.yml -- python3 $WORK/sock.py plant $WORK/home/sock/host.sock
[darwin] stdout '^DENIED plant E(ACCES|PERM)$'
[darwin] exec pmg sandbox exec --sandbox-profile $WORK/allow.yml -- python3 $WORK/sock.py $WORK/home/sock/host.sock
[darwin] stdout '^OK host$'

# The same holds for each link that a listed path follows, and for the
# socket at the end.
cd $WORK/home/sock
symlink mid.sock -> host.sock
symlink link.sock -> mid.sock
cd $WORK/proj
[darwin] ! exec pmg sandbox exec --sandbox-profile $WORK/link.yml -- python3 $WORK/sock.py plant $WORK/home/sock/mid.sock
[darwin] stdout '^DENIED plant E(ACCES|PERM)$'
[darwin] ! exec pmg sandbox exec --sandbox-profile $WORK/link.yml -- python3 $WORK/sock.py plant $WORK/home/sock/host.sock
[darwin] stdout '^DENIED plant E(ACCES|PERM)$'
[darwin] exec pmg sandbox exec --sandbox-profile $WORK/link.yml -- python3 $WORK/sock.py $WORK/home/sock/link.sock
[darwin] stdout '^OK host$'

# A run cannot repoint a linked directory on the way either. Before the
# swap, a/host.sock -> b/host.sock -> host.sock. After it, b names decoy,
# where host.sock links to other.sock.
cd $WORK/home/sock
mkdir decoy
symlink decoy/host.sock -> ../other.sock
symlink b -> .
symlink a -> b
cd $WORK/proj
[darwin] ! exec pmg sandbox exec --sandbox-profile $WORK/dir.yml -- python3 $WORK/sock.py swap $WORK/home/sock/b decoy
[darwin] stdout '^DENIED plant E(ACCES|PERM)$'
[darwin] exec pmg sandbox exec --sandbox-profile $WORK/dir.yml -- python3 $WORK/sock.py $WORK/home/sock/a/host.sock
[darwin] stdout '^OK host$'

kill listener
kill projlistener

-- proj/.keep --
-- allow.yml --
name: exec-one-socket
inherits: exec
package_managers: [exec]
network:
  allow_unix_connect:
    - ${HOME}/sock/host.sock
-- cwd.yml --
name: exec-one-socket-in-project
inherits: exec
package_managers: [exec]
network:
  allow_unix_connect:
    - ${CWD}/host.sock
-- sup.yml --
name: exec-one-socket-supervised
package_managers: [exec]
filesystem:
  allow_read:
    - /
process:
  allow_exec:
    - /usr/**
    - /bin/**
network:
  allow_unix_connect:
    - ${HOME}/sock/host.sock
  allow_unix_connect_without_kernel_check: true
-- link.yml --
name: exec-one-socket-link
inherits: exec
package_managers: [exec]
network:
  allow_unix_connect:
    - ${HOME}/sock/link.sock
-- dir.yml --
name: exec-one-socket-dir
inherits: exec
package_managers: [exec]
network:
  allow_unix_connect:
    - ${HOME}/sock/a/host.sock
-- bwrap.yml --
name: exec-one-socket-bwrap
inherits: exec
package_managers: [exec]
network_via_proxy_only: false
network:
  allow_unix_connect:
    - ${HOME}/sock/host.sock
-- sock.py --
import errno, os, signal, socket, sys, threading, time

# Relative paths stay below the macOS sun_path limit.
SOCKETS = ["host.sock", "other.sock"]

def listen():
    signal.signal(signal.SIGINT, lambda *_: os._exit(0))
    signal.signal(signal.SIGTERM, lambda *_: os._exit(0))
    threading.Timer(120, lambda: os._exit(0)).start()
    for path in SOCKETS:
        s = socket.socket(socket.AF_UNIX)
        s.bind(path)
        s.listen(8)
        threading.Thread(target=serve, args=(s, path.split(".")[0]), daemon=True).start()
    threading.Event().wait()

def serve(s, name):
    while True:
        c = s.accept()[0]
        c.sendall(name.encode())
        c.close()

def wait():
    for _ in range(100):
        if all(os.path.exists(p) for p in SOCKETS):
            return
        time.sleep(0.1)
    sys.exit("listener did not start")

def connect(path):
    # A relative name stays below the macOS sun_path limit.
    directory, name = os.path.split(path)
    if directory:
        os.chdir(directory)
    stage = "socket"
    try:
        s = socket.socket(socket.AF_UNIX)
        stage = "connect"
        s.connect(name)
        name = s.recv(16).decode()
    except OSError as e:
        print("DENIED " + stage + " " + errno.errorcode.get(e.errno, str(e.errno)))
        sys.exit(1)
    print("OK " + name)

def plant(path):
    try:
        os.unlink(path)
        os.symlink(os.path.join(os.path.dirname(os.path.abspath(path)), "other.sock"), path)
    except OSError as e:
        print("DENIED plant " + errno.errorcode.get(e.errno, str(e.errno)))
        sys.exit(1)
    print("PLANTED")

def swap(path, target):
    try:
        os.symlink(target, path + ".new")
        os.replace(path + ".new", path)
    except OSError as e:
        print("DENIED plant " + errno.errorcode.get(e.errno, str(e.errno)))
        sys.exit(1)
    print("PLANTED")

mode = sys.argv[1]
if mode == "listen":
    listen()
elif mode == "wait":
    wait()
elif mode == "plant":
    plant(sys.argv[2])
elif mode == "swap":
    swap(sys.argv[2], sys.argv[3])
else:
    connect(mode)
