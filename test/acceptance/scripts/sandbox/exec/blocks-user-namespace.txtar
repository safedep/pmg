# guarantee: on Linux, `pmg sandbox exec` refuses a nested user namespace.
# A program cannot get capabilities back in the sandbox.

[!linux] skip
[!userns] skip

env HOME=$WORK/home
mkdir $WORK/home
env PMG_CACHE_DIR=$WORK/cache
cd $WORK/proj

! exec pmg sandbox exec -- unshare -U true
stderr 'Operation not permitted'

-- proj/.keep --
