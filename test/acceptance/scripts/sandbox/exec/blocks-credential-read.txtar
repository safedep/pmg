# guarantee: under `pmg sandbox exec`, the mandatory credential denies apply
# to any program. A read of ~/.aws/credentials fails and its content never
# reaches stdout. A read of an ordinary file works.

env HOME=$WORK/home
env PMG_CACHE_DIR=$WORK/cache
cd $WORK/proj

! exec pmg sandbox exec -- cat $HOME/.aws/credentials
! stdout value-must-never-be-read

# A credential file nested in the repository. Landlock and Seatbelt deny the
# read. Bubblewrap masks the file, so cat prints nothing and exits zero.
exec pmg sandbox exec -- sh -c 'cat packages/app/.env || true'
! stdout nested-value-must-never-be-read

exec pmg sandbox exec -- cat readme.txt
stdout readable

-- home/.aws/credentials --
aws_secret_access_key = value-must-never-be-read
-- proj/packages/app/.env --
DB_PASSWORD=nested-value-must-never-be-read
-- proj/readme.txt --
readable
