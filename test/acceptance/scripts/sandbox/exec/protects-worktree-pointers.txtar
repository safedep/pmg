# guarantee: under `pmg sandbox exec`, the files that tell git where a
# linked worktree keeps its state are read-only, and a pointer that names
# something other than this checkout grants nothing. The .git file,
# worktrees/<name>/gitdir and worktrees/<name>/commondir decide what the
# next run may write, so a sandboxed process must not redirect them.

env HOME=$WORK/home
mkdir $WORK/home
env PMG_CACHE_DIR=$WORK/cache
env GIT_AUTHOR_NAME=pmg
env GIT_AUTHOR_EMAIL=pmg@example.com
env GIT_COMMITTER_NAME=pmg
env GIT_COMMITTER_EMAIL=pmg@example.com

exec git init -q $WORK/main
exec git -C $WORK/main commit -q --allow-empty -m init
exec git -C $WORK/main worktree add -q $WORK/wt
exec git init -q $WORK/other
cd $WORK/wt

# The worktree still works.
exec pmg sandbox exec -- git commit -q --allow-empty -m sandboxed

# The three pointer files stay as git wrote them.
! exec pmg sandbox exec -- sh -c 'echo "gitdir: $HOME" > .git'
grep '^gitdir: .*main/\.git/worktrees/wt$' .git

! exec pmg sandbox exec -- sh -c 'echo "$HOME" > ../main/.git/worktrees/wt/commondir'
grep '^\.\./\.\.$' ../main/.git/worktrees/wt/commondir

! exec pmg sandbox exec -- sh -c 'echo "$HOME/.git" > ../main/.git/worktrees/wt/gitdir'
grep 'wt/\.git$' ../main/.git/worktrees/wt/gitdir

# A .git file that names the home directory, or another repository, does
# not make either writable. The profile grants writes only inside the
# repository, because the default exec profile grants ${TMPDIR}, where this
# test keeps its home directory.
cd $WORK/evil
exec sh -c 'echo "gitdir: $HOME" > .git'
! exec pmg sandbox exec --sandbox-profile $WORK/repo-only.yml -- sh -c 'echo evil >> $HOME/.bashrc'
! exists $WORK/home/.bashrc

exec sh -c 'echo "gitdir: $WORK/other/.git" > .git'
! exec pmg sandbox exec --sandbox-profile $WORK/repo-only.yml -- sh -c 'echo evil > ../other/.git/refs/evil'
! exists $WORK/other/.git/refs/evil

-- evil/.keep --
-- repo-only.yml --
name: repo-only
description: exec profile that writes only inside the repository and its git directory
package_managers: [exec]
allow_pty: true
filesystem:
  allow_read:
    - /
  allow_write:
    - ${CWD}/**
    - ${CWD}/.git
network:
  allow_outbound:
    - "*:*"
process:
  allow_exec:
    - /usr/**
    - /bin/**
