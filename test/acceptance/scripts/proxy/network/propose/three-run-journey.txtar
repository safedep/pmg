# guarantee: a daemon run under audit with no profile observes every
# destination, `pmg proxy env` exports the run id, the stop report names
# the proposal command, the proposal
# writes a profile with one allow rule per destination, the IP literal
# denial and the catch-all deny, a dry run does not write the file, and a daemon under that profile in enforce refuses a destination
# the run did not reach.

[windows] skip 'pmg proxy start --daemon is not supported on Windows'

env HOME=$WORK/home
mkdir $WORK/home
env PMG_CACHE_DIR=$WORK/cache
env PMG_CONFIG_DIR=$WORK/config

exec sh observe.sh
stdout 'status 200'
stdout 'Destinations: [1-9][0-9]* observed. Propose a profile with: pmg sandbox profile propose --run [0-9a-f]{12}'
stdout 'by run: .*allowed .*add registry.npmjs.org:443'
stdout 'by run: Proposal: 1 new allow rule'

exec pmg sandbox profile propose --last
stdout 'registry.npmjs.org:443'
stdout 'add registry.npmjs.org:443'
! exists $WORK/ci.yml

exec pmg sandbox profile propose --last --new $WORK/ci.yml --dry-run
stdout 'Dry run. No file was written.'
! exists $WORK/ci.yml

exec pmg sandbox profile propose --last --new $WORK/ci.yml
stdout 'Wrote .*ci.yml'
exists $WORK/ci.yml
grep 'inherits: exec' $WORK/ci.yml
grep 'deny_ip_literals: true' $WORK/ci.yml
grep '    - registry.npmjs.org:443' $WORK/ci.yml
grep '    - "\*:\*"' $WORK/ci.yml
exec pmg sandbox profile lint $WORK/ci.yml

exec sh enforce.sh
stdout 'registry 200'
stdout 'connect 403'
stdout 'Network policy: enforce, 1 denied, 0 would deny'
stdout 'denied  pastebin.com:443  rule \*:\*'

-- observe.sh --
set -eu
pmg proxy start --daemon --port 0 --state "$PWD/state.json" --network-mode audit
eval "$(pmg proxy env --export --state "$PWD/state.json")"
status=$(curl --silent --show-error --max-time 30 --noproxy '' --cacert "$SSL_CERT_FILE" \
  --output /dev/null --write-out '%{http_code}' https://registry.npmjs.org/left-pad)
echo "status $status"
test -n "$PMG_PROXY_RUN"
pmg proxy stop --state "$PWD/state.json"
pmg sandbox profile propose --run "$PMG_PROXY_RUN" | sed 's/^/by run: /'
-- enforce.sh --
set -eu
pmg proxy start --daemon --port 0 --state "$PWD/state.json" --profile "$PWD/ci.yml" --network-mode enforce
eval "$(pmg proxy env --export --state "$PWD/state.json")"
status=$(curl --silent --show-error --max-time 30 --noproxy '' --cacert "$SSL_CERT_FILE" \
  --output /dev/null --write-out '%{http_code}' https://registry.npmjs.org/left-pad)
echo "registry $status"
# curl drops the body of a refused CONNECT, so the CONNECT status is the check.
status=$(curl --silent --max-time 30 --noproxy '' --cacert "$SSL_CERT_FILE" \
  --output /dev/null --write-out '%{http_connect}' https://pastebin.com/ || true)
echo "connect $status"
pmg proxy stop --state "$PWD/state.json" 2>&1 || true
