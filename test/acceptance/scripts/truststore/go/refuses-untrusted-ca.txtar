# guarantee: on macOS and Windows, pmg go stops before any module fetch when
# the OS trust store does not trust the PMG CA. go reads only the OS store
# there, so a fetch through the proxy would fail on TLS.

[!truststore] skip 'changes the system trust store: runs only on a disposable CI host'
[linux] skip 'go on Linux reads SSL_CERT_FILE, so it needs no OS trust'

cd proj
exec go mod init example.com/pmg-acceptance
! exec pmg go get github.com/google/uuid@v1.6.0
stderr 'Go cannot trust the PMG proxy CA'
! grep github.com/google/uuid go.mod

-- proj/.keep --
