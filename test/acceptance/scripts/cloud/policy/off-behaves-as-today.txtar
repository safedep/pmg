# guarantee: with cloud.policy off, pmg ignores the policy cache and installs
# as it does today, also when the cache blocks the package.

env HOME=$WORK/home
env PMG_CONFIG_DIR=$WORK/config
env SAFEDEP_API_KEY=
env SAFEDEP_TENANT_ID=
env PMG_CLOUD_ENABLED=
env PMG_CLOUD_ENDPOINT_ID=acceptance-policy
mkdir $WORK/home

policy-cache $WORK/config policy.textproto

exec pmg npm init -y
exec pmg npm --no-cache --prefer-online install left-pad@1.3.0
! stdout 'pmg: blocked'
exists node_modules/left-pad

exec pmg setup info --json
stdout '"state": "disabled"'

-- config/config.yml --
cloud:
  enabled: true
  policy: false
  auto_sync:
    enabled: false
-- policy.textproto --
spec {
  core {
    package_rules {
      rule_id: "r_acceptance_block"
      selector { purl: "pkg:npm/left-pad" }
      effect: EFFECT_BLOCK
      reason: "acceptance block"
    }
  }
}
