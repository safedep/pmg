# guarantee: a block entry of the cloud policy stops npm install through pmg,
# also when a trust entry and trusted_packages match. The block message cites
# the policy revision and the rule. The script writes the policy cache and
# runs with no cloud fetch.

env HOME=$WORK/home
env PMG_CONFIG_DIR=$WORK/config
env SAFEDEP_API_KEY=
env SAFEDEP_TENANT_ID=
env PMG_CLOUD_ENABLED=
env PMG_CLOUD_ENDPOINT_ID=acceptance-policy
mkdir $WORK/home

policy-cache $WORK/config policy.textproto

exec pmg npm init -y
! exec pmg npm --no-cache --prefer-online install left-pad@1.3.0
stdout 'pmg: blocked pkg:npm/left-pad@1\.3\.0 by the policy of your tenant'
stdout 'rule r_acceptance_block · policy revision 48 · default policy revision 12 · acceptance block'
! exists node_modules/left-pad

-- config/config.yml --
cloud:
  enabled: true
  policy: true
  auto_sync:
    enabled: false
trusted_packages:
  - purl: pkg:npm/left-pad
    reason: "trusted on this machine"
-- policy.textproto --
spec {
  core {
    package_rules {
      rule_id: "r_acceptance_block"
      selector { purl: "pkg:npm/left-pad" }
      effect: EFFECT_BLOCK
      reason: "acceptance block"
    }
    package_rules {
      rule_id: "r_acceptance_trust"
      selector { purl: "pkg:npm/left-pad" }
      effect: EFFECT_TRUST
      scopes: [TRUST_SCOPE_MALWARE, TRUST_SCOPE_COOLDOWN]
      reason: "reviewed"
      # 2100-01-01
      expires_at { seconds: 4102444800 }
    }
  }
}
