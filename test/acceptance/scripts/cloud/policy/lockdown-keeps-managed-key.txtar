# guarantee: under global_lockdown, the cloud policy does not change a key
# that the managed config sets. A min_age of zero in the policy cannot turn
# off the cooldown that IT locked, and pmg reports the field as locked.

[!root] skip 'the managed config needs root'
[windows] skip 'the managed config of this script is a Unix path'

env HOME=$WORK/home
env PMG_CONFIG_DIR=$WORK/config
env SAFEDEP_API_KEY=
env SAFEDEP_TENANT_ID=
env PMG_CLOUD_ENABLED=
env PMG_CLOUD_ENDPOINT_ID=acceptance-policy
mkdir $WORK/home
mkdir $WORK/config

# The harness restores the managed config when the script ends.
mkdir -p /etc/safedep/pmg
cp managed.yml /etc/safedep/pmg/config.yml

policy-cache $WORK/config policy.textproto

exec pmg setup info --json
stdout '"enabled": true,\s+"days": 14'
stdout '"locked": \[\s+"package_admission\.cooldown\.min_age"'

-- managed.yml --
global_lockdown: true
cloud:
  enabled: true
  policy: true
  endpoint_id: acceptance-policy
  auto_sync:
    enabled: false
dependency_cooldown:
  days: 14
-- policy.textproto --
spec {
  package_admission {
    cooldown { min_age { seconds: 0 } }
  }
}
