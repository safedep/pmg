# guarantee: blocked_packages blocks a package with no cloud. The block
# message names the config file and the rule.

env HOME=$WORK/home
env PMG_CONFIG_DIR=$WORK/config
env SAFEDEP_API_KEY=
env SAFEDEP_TENANT_ID=
env PMG_CLOUD_ENABLED=
mkdir $WORK/home

exec pmg npm init -y
! exec pmg npm --no-cache --prefer-online install left-pad@1.3.0
stdout 'pmg: blocked pkg:npm/left-pad@1\.3\.0 by blocked_packages in'
stdout 'rule local:[0-9a-f]{12} · IR-2291 credential stealer'
stdout 'The owner of that file can change the list'
! exists node_modules/left-pad

-- config/config.yml --
blocked_packages:
  - purl: pkg:npm/left-pad
    vers: "vers:npm/>=1.0.0|<2.0.0"
    reason: "IR-2291 credential stealer"
