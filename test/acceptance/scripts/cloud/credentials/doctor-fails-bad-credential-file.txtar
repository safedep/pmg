# guarantee: with cloud sync on, pmg setup doctor fails the Cloud credentials
# check when PMG_CLOUD_CREDENTIAL_FILE names a file that pmg cannot use. pmg
# then uses no other credentials, so the check does not pass on a keychain or
# an environment key. pmg setup info --json runs the same checks and exits 0,
# so the script reads its checks.

env HOME=$WORK/home
env PMG_CONFIG_DIR=$WORK/config
env SAFEDEP_API_KEY=sk-acceptance
env SAFEDEP_TENANT_ID=acceptance.safedep.io
env PMG_CLOUD_ENABLED=
env PMG_CLOUD_CREDENTIAL_FILE=$WORK/missing-credential.json
mkdir $WORK/home

exec pmg setup info --json
stdout '"name": "cloud-credentials",\s+"category": "Cloud",\s+"status": "fail",\s+"message": "pmg cannot use the credential file that PMG_CLOUD_CREDENTIAL_FILE names \('
stdout '"fix": "Run the job again to get a new credential in the file that PMG_CLOUD_CREDENTIAL_FILE names"'

-- config/config.yml --
cloud:
  enabled: true
  policy: false
  auto_sync:
    enabled: false
